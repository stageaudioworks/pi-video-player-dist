# =============================================================================
# Line endings
# =============================================================================
# Preventive, not a fix for a current problem: as of this commit every file in
# the repo is stored with LF, which is correct.
#
# Development happens on Windows and everything here is deployed to Linux
# (Raspberry Pi OS). Today that works because the local clone has
# core.autocrlf=true, which stores LF on commit. But that is a per-machine git
# setting, so a contributor with core.autocrlf=false could commit CRLF endings
# without noticing. On Linux that genuinely breaks a shell script: bash does not
# treat \r as whitespace, so `fi\r` is not `fi` and you get "syntax error:
# unexpected end of file" and "$'\r': command not found".
#
# bootstrap.sh is the most exposed, because `curl ... | sudo bash` pipes the raw
# committed bytes straight into bash with no checkout step to convert them.
#
# Pinning eol=lf here makes the deployed files independent of anyone's local git
# config or editor.

# Normalise all text on commit, and check it out with LF.
* text=auto eol=lf

# Explicit for the files that would break loudest.
*.sh           text eol=lf
*.service      text eol=lf
*.py           text eol=lf
*.md           text eol=lf
.gitattributes text eol=lf

# Media and archives must never be touched.
*.mp4  binary
*.mov  binary
*.jpg  binary
*.jpeg binary
*.png  binary
*.gz   binary
*.zip  binary
*.docx binary
